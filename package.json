    "onchain-notes-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "dev": "ts-node src/index.ts"
  },
  "keywords": [
    "mcp",
