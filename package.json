  "repository": {
    "type": "git",
    "url": "https://github.com/memosr/onchain-notes-mcp.git"
  },
  "homepage": "https://onchain-notes.vercel.app",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
